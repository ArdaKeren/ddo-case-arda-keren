POSTGRES_USER=qa
POSTGRES_PASSWORD=qa_secret
POSTGRES_DB=qa
POSTGRES_PORT=5432

DATABASE_URL=postgres://qa:qa_secret@localhost:5432/qa?sslmode=disable
HTTP_ADDR=:8080

# Auth: generate with  openssl rand -base64 48  (min 32 bytes)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-bytes
JWT_ISSUER=qa-backend
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# First seed user: created as admin on startup when no admin exists yet.
# The simulator logs in with it (-admin-password / SIM_ADMIN_PASSWORD).
ADMIN_EMAIL=seed.dalga@ddo-case.invalid
ADMIN_PASSWORD=

# Business day boundary for ticket numbers (A-001 resets daily)
QUEUE_TIMEZONE=Europe/Istanbul
# Separate, disposable DB for integration tests (tables are truncated!)
TEST_DATABASE_URL=postgres://qa:qa_secret@localhost:5432/qa_test?sslmode=disable

# WebSocket: host patterns allowed to connect cross-origin, and how long
# events stay replayable for screens that reconnect.
ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
EVENT_RETENTION=48h
